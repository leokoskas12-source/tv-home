<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://github.com/leokoskas12-source/tv-home" version="0.1.0" viewmodes="maximized">
  <access origin="*" subdomains="true"/>
  <tizen:application id="TVHome0001.TVHome" package="TVHome0001" required_version="2.3"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>Accueil</name>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <tizen:service id="TVHome0001.Boot" type="ui" auto-restart="true" on-boot="true">
    <tizen:content src="service.js"/>
    <tizen:name>Accueil demarrage</tizen:name>
    <tizen:icon src="icon.png"/>
    <tizen:description>Ouvre l'accueil au demarrage de la TV</tizen:description>
    <tizen:category name="http://tizen.org/category/service"/>
  </tizen:service>
  <tizen:profile name="tv-samsung"/>
</widget>
